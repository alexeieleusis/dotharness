# vibe_heal configuration file
# Copy this file to .env.vibeheal and update with your actual values.

# ============================================================================
# SonarQube Configuration (REQUIRED)
# ============================================================================

# SonarQube server URL (without trailing slash)
SONARQUBE_URL=https://sonar.example.com

# SonarQube project key
SONARQUBE_PROJECT_KEY=your-project-key

# Authentication: use EITHER a token (preferred) OR username/password

# Option 1: token authentication (recommended)
SONARQUBE_TOKEN=your-sonarqube-token-here

# Option 2: basic authentication (alternative to token)
# SONARQUBE_USERNAME=your-username
# SONARQUBE_PASSWORD=your-password

# ============================================================================
# AI Tool Configuration (OPTIONAL)
# ============================================================================

# AI tool to use: claude-code or opencode
# If not specified, vibe_heal auto-detects available tools.
# Priority: Claude Code first, then opencode
# AI_TOOL=claude-code
# AI_TOOL=opencode

# ============================================================================
# Context Enrichment (OPTIONAL - enhances AI fix quality)
# ============================================================================

# Number of lines to show before/after the issue line for context
# Default: 5
# CODE_CONTEXT_LINES=5

# Include full rule description and rationale in AI prompts
# Default: true
# INCLUDE_RULE_DESCRIPTION=true

# ============================================================================
# Scanner Execution (OPTIONAL)
# ============================================================================

# Max seconds to wait for the sonar-scanner subprocess before killing it.
# Increase this for large codebases where a full-project scan (cleanup,
# dedupe-branch, review) legitimately takes longer than the default.
# Default: 300
# SCANNER_TIMEOUT_SECONDS=300

# ============================================================================
# Commands
# ============================================================================

# View current configuration:
#   vibe_heal config

# Fix issues in a file (dry-run):
#   vibe_heal fix path/to/file.py --dry-run

# Fix issues in a file:
#   vibe_heal fix path/to/file.py

# Fix with limits:
#   vibe_heal fix path/to/file.py --max-issues 5 --min-severity MAJOR
